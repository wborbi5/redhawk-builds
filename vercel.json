{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/downloads/redhawk-builds-starter-v1.zip",
      "destination": "/downloads/redhawk-builds-starter-v1.1.zip",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(hero|logos)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ]
}
